---
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Worlds from '~/components/widgets/Worlds.astro';
import ProductShowcase from '~/components/widgets/ProductShowcase.astro';
import TrustCards from '~/components/widgets/TrustCards.astro';
import Cta from '~/components/widgets/Cta.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ledFosses from '~/assets/images/home/led-fosses.webp';
import quadBenda from '~/assets/images/home/quad-benda.webp';
import motoBenda from '~/assets/images/home/moto-benda.webp';

const metadata = {
  title: 'Motos BENDA, MAG POWER, quads BENDA & équipements LED à Fosses-la-Ville | LED Automotive',
  description:
    'Découvrez nos motos BENDA et MAG POWER, quads BENDA, équipements LED et offres du moment à Fosses-la-Ville. Essais sur demande et conseils personnalisés.',
  ignoreTitleTemplate: true,
};

const sortByOrder = (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999);

const featuredQuads = (await getCollection('quad', ({ data }) => !data.draft && !!data.featured)).sort(sortByOrder);
const featuredMotos = (await getCollection('moto', ({ data }) => !data.draft && !!data.featured && data.available)).sort(sortByOrder);
const featuredLeds = (await getCollection('led', ({ data }) => !data.draft && !!data.featured)).sort(sortByOrder);

const featuredItems = [
  ...featuredMotos.slice(0, 3).map((item) => ({
    type: 'moto',
    title: item.data.title,
    eyebrow: `Moto ${item.data.brand}`,
    href: `/motos/${item.data.slug ?? item.id}`,
    image: item.data.image,
    order: item.data.order ?? 999,
  })),
  ...featuredQuads.slice(0, 3).map((item) => ({
    type: 'quad',
    title: item.data.title,
    eyebrow: 'Quad BENDA',
    href: `/quads/${item.data.slug ?? item.id}`,
    image: item.data.image,
    order: item.data.order ?? 999,
  })),
  ...featuredLeds.slice(0, 2).map((item) => ({
    type: 'led',
    title: item.data.title,
    eyebrow: 'Leds & accessoires',
    href: `/leds/${item.data.slug ?? item.id}`,
    image: item.data.image,
    order: item.data.order ?? 999,
  })),
]
  .sort((a, b) => a.order - b.order)
  .slice(0, 6);

const featuredQuadCards = featuredQuads.slice(0, 3).map((item) => ({
  title: item.data.title,
  description: item.data.excerpt ?? item.data.description,
  href: `/quads/${item.data.slug ?? item.id}`,
  image: item.data.image,
  priceLabel: item.data.priceLabel,
  promoPriceLabel: item.data.promoPriceLabel,
  eyebrow: 'Quad BENDA',
  badge: item.data.promo ? 'Promo' : undefined,
}));

const featuredMotoCards = featuredMotos.slice(0, 3).map((item) => ({
  title: item.data.title,
  description: item.data.excerpt ?? item.data.description,
  href: `/motos/${item.data.slug ?? item.id}`,
  image: item.data.image,
  priceLabel: item.data.priceLabel,
  promoPriceLabel: item.data.promoPriceLabel,
  eyebrow: `Moto ${item.data.brand}`,
  badge: item.data.promo ? 'Promo' : undefined,
}));

const featuredLedCards = featuredLeds.slice(0, 3).map((item) => ({
  title: item.data.title,
  description: item.data.excerpt ?? item.data.description,
  href: `/leds/${item.data.slug ?? item.id}`,
  image: item.data.image,
  priceLabel: item.data.priceLabel,
  promoPriceLabel: item.data.promoPriceLabel,
  eyebrow: 'Leds & accessoires',
  badge: item.data.promo ? 'Promo' : undefined,
}));

const worldsItems = [
  {
    title: 'Motos BENDA & MAG POWER',
    description: 'Roadsters, customs et motos accessibles pour le plaisir, les trajets et les balades.',
    href: '/motos',
    image: motoBenda,
    cta: 'Découvrir les motos',
    badge: 'Nouveau',
  },
  {
    title: 'Quads BENDA',
    description: 'Modèles route et tout-terrain, adaptés au loisir comme à un usage polyvalent.',
    href: '/quads',
    image: quadBenda,
    cta: 'Découvrir les quads',
  },
  {
    title: 'Leds & accessoires',
    description: 'Améliorez votre visibilité et équipez votre véhicule avec du matériel fiable.',
    href: '/leds',
    image: ledFosses,
    cta: 'Voir les équipements',
  },
];

const trustItems = [
  {
    icon: 'lucide:shield-check',
    title: 'Produits sélectionnés',
    description: 'Nous privilégions des équipements fiables, testés et adaptés à un usage concret.',
  },
  {
    icon: 'lucide:map-pinned',
    title: 'Entreprise locale',
    description: 'Un service de proximité avec un interlocuteur accessible et réactif.',
  },
  {
    icon: 'lucide:message-circle-more',
    title: 'Conseils personnalisés',
    description: 'On vous aide à choisir le bon produit selon votre véhicule et votre besoin.',
  },
  {
    icon: 'lucide:wrench',
    title: 'Suivi après achat',
    description: 'Nous restons disponibles après la vente pour vous accompagner si nécessaire.',
  },
];
---

<Layout metadata={metadata}>
  <Hero2
    actions={[
      {
        variant: 'primary',
        text: 'Réserver mon essai',
        href: 'tel:+32499610628',
        icon: 'lucide:phone',
      },
      {
        text: 'Demander une offre',
        href: '/contact',
      },
    ]}
    image={{ src: '~/assets/images/led-automotive.webp', alt: 'Motos et quads BENDA & MAGPOWER à Fosses-la-Ville' }}
  >
    <Fragment slot="title">
  Motos, quads et équipements LED à Fosses-la-Ville
</Fragment>

<Fragment slot="subtitle">
  <span class="block mb-2 font-semibold">
    Motos BENDA, motos MAG POWER et quads BENDA disponibles sur demande
  </span>
  Découvrez nos véhicules, demandez une offre ou réservez un essai près de Fosses-la-Ville.
</Fragment>

    <Fragment slot="socialLink">
  <a
    href="https://www.facebook.com/profile.php?id=61563294435406"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-white transition mx-auto lg:mx-0"
  >
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#1877F2] text-white">
      <Icon name="logos:facebook" class="h-4 w-4" />
    </span>
    <span>Voir nos véhicules en action</span>
  </a>
</Fragment>

    <Fragment slot="content">
      {featuredItems.length > 0 && (
        <div class="heroMiniGalleryWrap">
          <div class="heroMiniGalleryHeader">
            <p class="heroMiniGalleryLabel">À découvrir</p>

            <div class="heroMiniGalleryControls">
              <button type="button" class="heroMiniGalleryBtn" data-hero-gallery-prev aria-label="Précédent">
                ←
              </button>
              <button type="button" class="heroMiniGalleryBtn" data-hero-gallery-next aria-label="Suivant">
                →
              </button>
            </div>
          </div>

          <div class="heroMiniGalleryViewport">
  <div class="heroMiniGallery" data-hero-gallery>
    {featuredItems.map((item) => (
      <a href={item.href} class="heroMiniCard">
        <div class="heroMiniCardMedia">
          <Image
            src={item.image}
            alt={item.title}
            width={640}
            height={360}
            sizes="(max-width: 768px) 80vw, 220px"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="heroMiniCardBody">
          <p class="heroMiniCardEyebrow">{item.eyebrow}</p>
          <p class="heroMiniCardTitle">{item.title}</p>
        </div>
      </a>
    ))}
  </div>
</div>

        </div>
      )}
    </Fragment>
  </Hero2>

  <Worlds items={worldsItems} />


  <ProductShowcase
  tagline="Motos à découvrir"
  title="Nos motos à découvrir"
  subtitle="Une sélection de motos BENDA et MAG POWER mises en avant."
  items={featuredMotoCards}
  ctaHref="/motos"
  ctaText="Voir toutes les motos"
/>

  <ProductShowcase
    tagline="Quads à découvrir"
    title="Nos quads à découvrir"
    subtitle="Une sélection de quads BENDA mis en avant."
    items={featuredQuadCards}
    ctaHref="/quads"
    ctaText="Voir tous les quads"
  />

  <ProductShowcase
    tagline="Leds à découvrir"
    title="Nos leds & accessoires à découvrir"
    subtitle="Retrouvez une sélection de leds et accessoires mis en avant."
    items={featuredLedCards}
    ctaHref="/leds"
    ctaText="Voir tous les équipements"
  />

  <TrustCards
    id="reassurance"
    title="Un service simple, local et fiable"
    subtitle="Basés à Fosses-la-Ville, nous vous offrons des conseils clairs et un suivi de proximité."
    items={trustItems}
  />

  <Cta />
</Layout>

<style>
  .heroMiniCard {
  position: relative;
  overflow: hidden;
  border-radius: 24px;
}

.heroMiniCardMedia {
  height: 128px;
  overflow: hidden;
}

.heroMiniCardMedia :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
</style>