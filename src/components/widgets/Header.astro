---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';


interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  image?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const megaMenuContent: Record<
  string,
  { title: string; description: string }
> = {
  véhicules: {
    title: 'Motos & Quads BENDA - MAG POWER',
    description:
      'Nos motos et quads des marques BENDA & MAG POWER',
  },

  leds: {
    title: 'Éclairage LED haute performance',
    description:
      'Barres LED, phares, feux additionnels et solutions d’éclairage pour gagner en visibilité.',
  },

  accessoires: {
    title: 'Faisceaux & accessoires',
    description:
      'Câblages, supports, connectiques et accessoires pour une installation propre et fiable.',
  },

  promos: {
    title: 'Promotions & bonnes affaires',
    description:
      'Profitez des offres spéciales, nouveautés et produits sélectionnés à prix avantageux.',
  },
};
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },

    'siteHeader top-0 z-50 flex-none mx-auto w-full',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div
  class:list={[
    'relative text-default py-3 px-3 lg:px-6 mx-auto w-full',

    { 'lg:flex lg:justify-between': position !== 'center' },
    { 'lg:grid lg:grid-cols-3 lg:items-center': position === 'center' },
    { 'max-w-7xl': !isFullWidth },
  ]}
>
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a
        class="headerLogo flex items-center rounded-2xl px-2 py-1"
        href={getHomePermalink()}
      >
        <Logo />
      </a>

      <div class="flex items-center lg:hidden">
        <ToggleMenu />
      </div>
    </div>

    <nav
      class="items-center w-full lg:w-auto hidden lg:flex lg:mx-5 text-default overflow-y-auto overflow-x-hidden lg:overflow-visible lg:justify-self-center"
      aria-label="Main navigation"
    >
      <!-- Mobile -->
      <ul class="lg:hidden mt-6 flex flex-col text-base font-medium">
        {
          links.map(({ text, href, links }) => (
            <li>
              {links?.length ? (
                <details class="group border-b border-white/10">
                  <summary class="mobileSubmenuToggle list-none px-4 py-4 flex items-center justify-between cursor-pointer">
                    <span>{text}</span>
                    <Icon
                      name="tabler:chevron-down"
                      class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                    />
                  </summary>

                  <ul class="px-3 pb-4 grid gap-1">
                    {links.map(({ text: text2, href: href2, image }) => (
                      <li>
                        <a
                          class:list={[
                            'flex items-center gap-3 py-3 px-4 rounded-xl text-sm bg-white/[0.03] hover:bg-white/[0.08]',
                            { 'aw-link-active bg-white/[0.08]': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {image && (
                            <img
                              src={image}
                              alt=""
                              loading="lazy"
                              class="h-10 w-10 rounded-lg object-cover bg-white/5"
                            />
                          )}
                          <span>{text2}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  class:list={[
                    'px-4 py-4 block border-b border-white/10',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- Desktop -->
      <ul class="hidden lg:flex items-center gap-1 text-[0.9375rem] tracking-[0.01rem] font-medium">
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'megaItem' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="megaButton px-4 py-3 flex items-center gap-1 whitespace-nowrap hover:text-white/90"
                  >
                    {text}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" />
                  </button>

                  <div class="megaPanel invisible opacity-0 pointer-events-none transition-all duration-200 absolute left-0 right-0 top-full z-50">
                    <div class="bg-[#080a10]/95 backdrop-blur-xl border-t border-white/10 border-b border-white/10 shadow-2xl">
                      <div class="mx-auto max-w-7xl px-6 py-8">
                        <div class="grid grid-cols-[260px_1fr] gap-10">
                          <div>
                            <p class="text-sm uppercase tracking-[0.18em] text-white/40 mb-3">
                              {text}
                            </p>
                            <p class="text-2xl font-semibold text-white leading-tight">
                              {megaMenuContent[text?.toLowerCase()]?.title ?? 'Équipement LED'}
                            </p>

                            <p class="mt-3 text-sm text-white/55 leading-relaxed">
                              {megaMenuContent[text?.toLowerCase()]?.description ??
                                'Découvrez notre sélection de produits LED.'}
                            </p>
                          </div>

                          <ul class="grid grid-cols-2 xl:grid-cols-3 gap-2">
                            {links.map(({ text: text2, href: href2, image }) => (
                              <li>
                                <a
                                  class:list={[
                                    'group/item flex items-center gap-3 rounded-xl px-4 py-3 hover:bg-white/[0.08] transition-colors',
                                    { 'bg-white/[0.08] text-white': href2 === currentPath },
                                  ]}
                                  href={href2}
                                >
                                  {image ? (
                                    <img
                                      src={image}
                                      alt=""
                                      loading="lazy"
                                      class="h-12 w-12 rounded-xl object-cover bg-white/5 shrink-0"
                                    />
                                  ) : (
                                    <span class="h-12 w-12 rounded-xl bg-white/[0.05] shrink-0 flex items-center justify-center">
                                      <Icon name="tabler:bulb" class="w-5 h-5 text-white/45" />
                                    </span>
                                  )}

                                  <span>
                                    <span class="block text-sm font-semibold text-white/90 group-hover/item:text-white">
                                      {text2}
                                    </span>
                                    <span class="mt-1 block text-xs text-white/45">
                                      Voir les produits
                                    </span>
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-white/90 px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden lg:self-center lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end',
      ]}
    >
      <div class="items-center flex justify-between w-full lg:w-auto">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>

        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  class="ml-2 py-2.5 px-5.5 lg:px-6 font-semibold shadow-none text-sm w-auto"
                />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>

<style>

.siteHeader {
  position: fixed;
  inset: 0 0 auto 0;
  width: 100%;
  background: transparent;
  border-bottom: 0;
  z-index: 50;
}

.siteHeader::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;

  background:
    linear-gradient(
      180deg,
      rgba(8,10,16,.42) 0%,
      rgba(8,10,16,.22) 100%
    );

  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);

  border-bottom: 1px solid rgba(255,255,255,.06);

  transition:
    background .28s ease,
    border-color .28s ease,
    box-shadow .28s ease;
}

.siteHeader.is-scrolled::before {
  background:
    linear-gradient(
      180deg,
      rgba(8,10,16,.92) 0%,
      rgba(8,10,16,.86) 100%
    );

  border-bottom-color: rgba(255,255,255,.08);

  box-shadow: 0 14px 34px rgba(0,0,0,.26);
}

.siteHeader > div {
  background: transparent !important;
}

/* ---------- NAV LINKS ---------- */

.siteHeader nav a,
.siteHeader nav button {

  position: relative;

  padding: .95rem 1rem;

  color: rgba(255,255,255,.86);

  font-weight: 600;

  letter-spacing: .015em;

  transition:
    color .22s ease,
    transform .22s ease,
    text-shadow .22s ease;
}

/* trait repos subtil */

.siteHeader nav a::before,
.siteHeader nav button::before {

  content:'';

  position:absolute;

  left:50%;
  bottom:5px;

  width:26px;
  height:2px;

  border-radius:999px;

  background:
    linear-gradient(
      90deg,
      rgba(225,6,0,.08),
      rgba(255,69,58,.22)
    );

  transform:
    translateX(-50%)
    scaleX(.65);

  opacity:.55;

  transition:
    width .24s ease,
    opacity .24s ease,
    transform .24s ease,
    box-shadow .24s ease;
}

/* hover */

.siteHeader nav a:hover,
.siteHeader nav button:hover {

  color:white;

  transform:translateY(-1px);

  text-shadow:
    0 0 18px rgba(255,255,255,.08);
}

/* trait actif hover */

.siteHeader nav a:hover::before,
.siteHeader nav button:hover::before {

  width:72%;

  opacity:1;

  transform:
    translateX(-50%)
    scaleX(1);

  background:
    linear-gradient(
      90deg,
      #e10600 0%,
      #ff453a 100%
    );

  box-shadow:
    0 0 14px rgba(225,6,0,.28);
}

.siteHeader > div {

  background:transparent !important;
}

/* logo */

.headerLogo {

  background:transparent;

  transition:.22s;
}

/* IMPORTANT */

.headerLogo :global(img),
.headerLogo :global(svg) {

  background:transparent !important;
}

.headerLogo::before {

  content:none;
}


/* CTA desktop */

.siteHeader :global(.btn-primary) {

  backdrop-filter:blur(12px);
}

/* mega panel */

.megaPanel > div {

  background:
    linear-gradient(
      180deg,
      rgba(10,12,18,.96) 0%,
      rgba(8,10,16,.94) 100%
    ) !important;

  backdrop-filter:blur(34px);
  -webkit-backdrop-filter:blur(34px);

  border-top:1px solid rgba(255,255,255,.08);
  border-bottom:1px solid rgba(255,255,255,.08);

  box-shadow:
    0 28px 60px rgba(0,0,0,.42);
}

</style>

<script is:inline>
  const bindMobileSubmenus = () => {
    document.querySelectorAll('.mobileSubmenuToggle').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.stopPropagation();
      });
    });
  };

  document.addEventListener('DOMContentLoaded', bindMobileSubmenus);
  document.addEventListener('astro:after-swap', bindMobileSubmenus);

  const bindMegaMenus = () => {
  document.querySelectorAll('.megaItem').forEach((item) => {
    const panel = item.querySelector('.megaPanel');
    const icon = item.querySelector('.megaButton svg');
    let closeTimer;

    const open = () => {
      clearTimeout(closeTimer);
      panel?.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
      panel?.classList.add('visible', 'opacity-100', 'pointer-events-auto');
      icon?.classList.add('rotate-180');
    };

    const close = () => {
      closeTimer = window.setTimeout(() => {
        panel?.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        panel?.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
        icon?.classList.remove('rotate-180');
      }, 220);
    };

    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', close);
    panel?.addEventListener('mouseenter', open);
    panel?.addEventListener('mouseleave', close);
  });
};

document.addEventListener('DOMContentLoaded', bindMegaMenus);
document.addEventListener('astro:after-swap', bindMegaMenus);

const bindHeaderScroll = () => {

  const header = document.querySelector('.siteHeader');

  if(!header) return;

  const update = () => {

    header.classList.toggle(
      'is-scrolled',
      window.scrollY > 24
    );
  };

  update();

  window.addEventListener('scroll', update);
};

document.addEventListener(
  'DOMContentLoaded',
  bindHeaderScroll
);

document.addEventListener(
  'astro:after-swap',
  bindHeaderScroll
);
</script>