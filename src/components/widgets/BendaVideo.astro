---
import { Icon } from 'astro-icon/components';
---

<section aria-labelledby="benda-video-title" class="not-prose px-4 py-12 sm:px-6 lg:px-8">
  <div
    class="mx-auto grid max-w-7xl items-center gap-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-10 lg:grid-cols-2 lg:gap-12"
  >
    <div class="lg:order-2">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">La gamme BENDA en vidéo</p>
      <h2 id="benda-video-title" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Redstone 550 ou 1000 : lequel vous correspond ?
      </h2>
      <p class="mt-5 leading-8 text-slate-300">
        Découvrez les BENDA Redstone 550 et 1000 dans cet essai vidéo. Une première immersion dans la gamme avant de
        venir découvrir les modèles chez LED Automotive, à Fosses-la-Ville.
      </p>
      <p class="mt-3 leading-8 text-slate-300">
        Vous hésitez entre les deux ? Nous vous accompagnons dans votre choix selon vos envies et votre utilisation.
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a
          href="tel:+32499610628"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          <Icon name="lucide:phone" class="h-4 w-4" />
          Réserver un essai
        </a>
        <a
          href="/quads"
          class="inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-primary hover:text-primary"
        >
          Découvrir la gamme BENDA <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="min-w-0 lg:order-1">
      <div data-benda-video class="relative aspect-video overflow-hidden rounded-2xl bg-black">
        <button
          type="button"
          data-play-video
          aria-label="Lire la vidéo : Essai BENDA Redstone 550 et 1000"
          class="group absolute inset-0 h-full w-full focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
        >
          <img
            src="https://i.ytimg.com/vi/MKtyFOsaYzs/hqdefault.jpg"
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          <span
            class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/30 transition group-hover:bg-black/15"
          >
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary text-white shadow-lg">
              <Icon name="lucide:play" class="h-7 w-7" />
            </span>
            <span class="rounded-full bg-black/70 px-4 py-2 text-sm font-semibold text-white">Voir l’essai vidéo</span>
          </span>
        </button>
      </div>
      <a
        href="https://www.youtube.com/watch?v=MKtyFOsaYzs"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm text-slate-400 underline underline-offset-4 transition hover:text-white"
      >
        ESSAI BENDA REDSTONE 550 &amp; 1000 · Voir sur YouTube
        <span class="sr-only">(nouvel onglet)</span>
        <Icon name="lucide:external-link" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

<script>
  function initBendaVideo() {
    document.querySelectorAll<HTMLButtonElement>('[data-play-video]').forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.addEventListener('click', () => {
        const container = button.closest('[data-benda-video]');
        if (!container) return;
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/MKtyFOsaYzs?autoplay=1&rel=0';
        iframe.title = 'ESSAI BENDA REDSTONE 550 & 1000';
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;
        container.replaceChildren(iframe);
        iframe.focus();
      });
    });
  }
  initBendaVideo();
  document.addEventListener('astro:page-load', initBendaVideo);
</script>
