    ],
  },
  buyingGuide: {
    title: `Moto ${brand} Belgique : comment choisir ?`,
    paragraphs: [
      'Le choix du bon modèle dépend de votre permis, de votre expérience, de votre budget et du type d’utilisation recherché.',
      'Nous pouvons vous accompagner dans la comparaison des modèles disponibles et vous conseiller avant votre achat.',
    ],
  },
  faqTitle: `Questions fréquentes sur les motos ${brand}`,
  faq: [
    {
      question: `Où acheter une moto ${brand} en Belgique ?`,
      answer: `Vous pouvez découvrir les motos ${brand} chez LED Automotive à Fosses-la-Ville, près de Namur.`,
    },
    {
      question: `Peut-on essayer une moto ${brand} ?`,
      answer: 'Oui, un essai peut être demandé sur rendez-vous selon les modèles disponibles.',
    },
  ],
  asideEyebrow: 'Besoin d’un conseil ?',
  asideTitle: 'Demandez un essai ou plus d’infos',
  asideText: `Vous hésitez entre plusieurs motos ${brand} ? Nous pouvons vous orienter selon votre permis, votre budget et les modèles disponibles.`,
};

const pageSeo = brandSeo[brand] ?? defaultSeo;

const metadata = {
  title: pageSeo.title,
  description: pageSeo.description,
};

const motoInfoBlocks = pageSeo.blocks;
---

<PageLayout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <CatalogHero
      eyebrow={pageSeo.eyebrow}
      title={pageSeo.heroTitle}
      intro={pageSeo.intro}
      body={pageSeo.body}
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {motos.map((moto) => (
        <ProductCard
          href={getMotoUrl(moto)}
          title={moto.data.title}
          image={moto.data.image}
          description={moto.data.excerpt}
          priceLabel={moto.data.priceLabel}
          promoPriceLabel={moto.data.promoPriceLabel}
          badge={moto.data.promo ? 'Promo' : undefined}
          eyebrow={`Moto ${moto.data.brand}`}
        />
      ))}
    </div>

    <div class="mx-auto mt-16 max-w-4xl space-y-6">
      <h2 class="text-2xl font-semibold">{pageSeo.longContent.title}</h2>
      {pageSeo.longContent.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <h2 class="text-2xl font-semibold">{pageSeo.buyingGuide.title}</h2>
      {pageSeo.buyingGuide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <h2 class="text-2xl font-semibold">{pageSeo.faqTitle}</h2>

      {pageSeo.faq.map((item) => (
        <>
          <h3 class="text-xl font-medium">{item.question}</h3>
          <p>{item.answer}</p>
        </>
      ))}
    </div>
  </section>

  <InfoSplitSection
    blocks={motoInfoBlocks}
    asideEyebrow={pageSeo.asideEyebrow}
    asideTitle={pageSeo.asideTitle}
    asideText={pageSeo.asideText}
    primaryCtaHref="/contact"
    primaryCtaText="Réserver un essai"
    secondaryCtaHref="/contact"
    secondaryCtaText="Nous contacter"
  />
</PageLayout>